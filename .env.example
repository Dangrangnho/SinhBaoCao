# Gemini OpenAI-compatible endpoint (or any OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Pipeline limits and generation settings
CHUNK_SIZE=6000
CHUNK_OVERLAP=500
ANALYSIS_TEMPERATURE=0.1
REPORT_TEMPERATURE=0.3
REQUEST_TIMEOUT=60
MAX_RETRIES=2
MAX_FILE_SIZE=10485760
MAX_ARCHIVE_SIZE=52428800
MAX_ARCHIVE_EXTRACTED_SIZE=104857600
MAX_ARCHIVE_MEMBERS=1000
MAX_TOTAL_UPLOAD_SIZE=104857600
MAX_CHUNKS=500
MAX_REVISION=1
